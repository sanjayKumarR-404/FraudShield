generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FROZEN
  FAILED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  upiVpa    String   @unique @map("upi_vpa")
  isFlagged Boolean  @default(false) @map("is_flagged")
  createdAt DateTime @default(now()) @map("created_at")

  sentTransactions     Transaction[] @relation("SenderTransactions")
  profile              UserProfile?

  batchJobs BatchJob[]

  @@map("users")
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Computed from transaction history
  avgTransactionAmount Float @default(0)
  minTransactionAmount Float @default(0)
  maxTransactionAmount Float @default(0)
  stdDevAmount         Float @default(0)

  // Time patterns
  mostCommonHour        Int   @default(10) // 0-23
  nightTransactionRatio Float @default(0) // % txns between 00:00-06:00

  // Behavioral patterns
  favoriteReceiverVpas String[] @default([]) // Top 5 receiver VPAs
  favoriteLocations    String[] @default([]) // Top 5 locations

  // Anomaly thresholds (learned from user's own data)
  amountZscoreThreshold Float @default(2.5) // Flag if amount > mean + 2.5*stddev
  velocityThreshold     Int   @default(10) // Flag if > 10 txns in 60 seconds

  // Metadata
  transactionsProcessed Int      @default(0)
  profileUpdatedAt      DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@map("user_profiles")
}

model Transaction {
  id          String            @id @default(uuid())
  senderVpa   String            @map("sender_vpa")
  receiverVpa String            @map("receiver_vpa")
  amount      Decimal           @db.Decimal(12, 2)
  rrn         String            @unique @db.VarChar(12)
  status      TransactionStatus @default(PENDING)
  isFraud     Boolean           @default(false) @map("is_fraud")
  location    String
  riskScore   Float?            @map("risk_score")
  reason      String?
  timestamp   DateTime          @default(now())

  sender        User           @relation("SenderTransactions", fields: [senderVpa], references: [upiVpa])

  whatsappAlertSent Boolean   @default(false)
  voiceAlertSent    Boolean   @default(false)
  alertSentAt       DateTime?
  attributionData   String?   @map("attribution_data")

  batchId String?
  batch   BatchJob? @relation("BatchTransactions", fields: [batchId], references: [id])

  @@index([senderVpa])
  @@index([receiverVpa])
  @@index([status])
  @@map("transactions")
}

enum RecoveryStatus {
  INITIATED
  BANK_NOTIFIED
  RBI_ESCALATED
  RESOLVED
  FAILED
  EXPIRED
}

model RecoveryCase {
  id                    String   @id @default(uuid())
  transactionId         String   @unique
  
  // Complainant details
  complainantName       String
  complainantEmail      String
  complainantPhone      String?
  bankName              String?
  accountNumber         String?
  
  // Recovery tracking
  status                String   @default("INITIATED")
  description           String?
  initiatedAt           DateTime @default(now())
  expiresAt             DateTime
  resolvedAt            DateTime?
  
  // FIR fields
  firNumber             String?
  firStatus             String   @default("INITIATED")
  policeStationName     String?
  evidenceUploads       String[] @default([])
  screenshotsCount      Int      @default(0)
  bankStatementsCount   Int      @default(0)
  chatHistoriesCount    Int      @default(0)
  firPdfPath            String?
  registeredAt          DateTime?
  estimatedResolutionAt DateTime?
  
  // Reminders
  day30Reminded         Boolean  @default(false)
  day60Reminded         Boolean  @default(false)
  day85Reminded         Boolean  @default(false)
  
  // Resolution
  recoveryAmount        Float?
  recoveryDate          DateTime?
  
  // Legacy fields (keep for backward compat)
  pdfPath               String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@map("recovery_cases")
}

model BatchJob {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // File info
  fileName String
  fileSize Int

  // Processing stats
  totalCount     Int @default(0)
  processedCount Int @default(0)
  frozenCount    Int @default(0)
  allowedCount   Int @default(0)

  // Report data (stored as JSON)
  reportData String?

  // Status
  status       String  @default("PROCESSING")
  errorMessage String?

  // Timestamps
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Relations
  transactions Transaction[] @relation("BatchTransactions")
}

model ReceiverProfile {
  id                   String   @id @default(uuid())
  receiverVpa          String   @unique

  // Transaction statistics
  totalReceived        Int      @default(0)
  totalFraudFlagged    Int      @default(0)
  fraudRate            Float    @default(0)

  // Velocity tracking
  uniqueSendersLast24h Int      @default(0)
  totalAmountLast24h   Float    @default(0)
  avgAmountReceived    Float    @default(0)

  // Account risk signals
  isNewAccount         Boolean  @default(false)
  firstSeenAt          DateTime @default(now())
  lastSeenAt           DateTime @updatedAt
  riskScore            Float    @default(0)
  riskCategory         String   @default("UNKNOWN") // SAFE, SUSPICIOUS, HIGH_RISK, FRAUD_MULE

  createdAt            DateTime @default(now())

  @@map("receiver_profiles")
}
